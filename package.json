{
  "name": "oilguard",
  "version": "0.1.0",
  "private": true,
  "description": "OILGUARD - monitoramento inteligente de níveis de óleo",
  "workspaces": [
    "apps/api",
    "apps/client"
  ],
  "engines": {
    "node": ">=22.16 <27"
  },
  "scripts": {
    "dev": "concurrently -n API,APP -c blue,green \"npm run dev:api\" \"npm run dev:app\"",
    "dev:api": "npm run dev --workspace @oilguard/api",
    "dev:app": "npm run dev --workspace @oilguard/client",
    "start": "npm run start --workspace @oilguard/api",
    "build": "npm run build --workspace @oilguard/client",
    "build:desktop": "npm run tauri:build --workspace @oilguard/client",
    "dev:desktop": "npm run tauri:dev --workspace @oilguard/client",
    "android:add": "npm run android:add --workspace @oilguard/client",
    "android:sync": "npm run android:sync --workspace @oilguard/client",
    "android:open": "npm run android:open --workspace @oilguard/client",
    "simulator": "node tools/simulator.mjs",
    "test": "node --test apps/api/test/*.test.js",
    "test:postgres": "node --test apps/api/test/postgres*.integration.mjs",
    "db:migrate": "npm run db:migrate --workspace @oilguard/api",
    "db:import": "npm run db:import --workspace @oilguard/api --",
    "admin:bootstrap": "npm run admin:bootstrap --workspace @oilguard/api",
    "admin:recover": "npm run admin:recover --workspace @oilguard/api",
    "android:run": "npm run android:run --workspace @oilguard/client",
    "typecheck": "npm run typecheck --workspace @oilguard/client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
