PORT=3333
HOST=127.0.0.1
DATA_MODE=simulation
# Configure DATABASE_URL ou as variáveis PGHOST, PGPORT, PGUSER, PGPASSWORD e PGDATABASE.
DATABASE_URL=
DB_POOL_MAX=10
# Gere uma credencial aleatória para a ingestão por CLI ou dispositivos.
INGEST_TOKEN=
CORS_ORIGINS=
PUBLIC_ORIGIN=
TRUST_PROXY_HOPS=0
SERVE_WEB=false
# Informe quando a equipe confirmar a frequência esperada de envio.
EXPECTED_READING_INTERVAL_SECONDS=
# Opcional. Usado apenas pelo importador SQLite.
# DB_FILE=./data/oilguard.sqlite
