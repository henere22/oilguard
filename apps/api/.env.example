PORT=3333
HOST=127.0.0.1
DATA_MODE=simulation
# Use DATABASE_URL nos containers, no Worker e em produção.
DATABASE_URL=
DB_POOL_MAX=10
# Habilitar nos dois processos apenas em DATA_MODE=simulation. Começa pausado.
SIMULATOR_ENABLED=false
WORKER_HEALTH_PORT=3336
# Credencial da API de ingestão por dispositivos. O Worker conecta direto ao PostgreSQL.
INGEST_TOKEN=
CORS_ORIGINS=
PUBLIC_ORIGIN=
TRUST_PROXY_HOPS=0
SERVE_WEB=false
# Informe quando a equipe confirmar a frequência esperada de envio.
EXPECTED_READING_INTERVAL_SECONDS=
# Opcional. Usado apenas pelo importador SQLite.
# DB_FILE=./data/oilguard.sqlite
