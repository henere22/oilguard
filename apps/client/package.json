{
  "name": "@oilguard/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:desktop": "vite build --mode desktop",
    "build:android": "vite build --mode android",
    "preview": "vite preview --host 0.0.0.0",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:add": "npm run build:android && cap add android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tauri-apps/cli": "^2.12.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
